#version 450
// Known PC compute shader for the T-601 harness (not a translated shader).
// out[i] = in[i] * 3 + i   (u32, wraps modulo 2^32)
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) readonly buffer Input { uint data[]; } input_buffer;
layout(set = 0, binding = 1) writeonly buffer Output { uint data[]; } output_buffer;

void main() {
    uint i = gl_GlobalInvocationID.x;
    output_buffer.data[i] = input_buffer.data[i] * 3u + i;
}
